{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.telemetry.example/common.schema.json",
  "title": "Common definitions",
  "description": "Shared definitions for every topic schema. Synthetic data only. Topic schemas reference these per field (no allOf), so additionalProperties: false stays valid.",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {},
  "$defs": {
    "vin": {
      "type": "string",
      "pattern": "^SYN[A-HJ-NPR-Z0-9]{14}$",
      "minLength": 17,
      "maxLength": 17,
      "description": "Synthetic VIN: 'SYN' plus 14 characters from A-Z and 0-9 excluding I, O and Q.",
      "x-privacy": "vehicle-id"
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Producer-assigned UUID, lowercase canonical form. Duplicates reuse it.",
      "x-privacy": "none"
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "UUID, lowercase canonical form.",
      "x-privacy": "none"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "description": "RFC 3339 UTC timestamp with milliseconds and a trailing Z, e.g. 2026-10-01T00:00:00.000Z.",
      "x-privacy": "none"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "UTC calendar date, YYYY-MM-DD.",
      "x-privacy": "none"
    },
    "producer_seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Starts at 1 and is strictly increasing per VIN per topic in event-time order. A duplicate keeps the original value. Heartbeats continue the sequence.",
      "x-privacy": "none"
    },
    "schema_version": {
      "type": "string",
      "const": "1",
      "description": "Envelope schema version.",
      "x-privacy": "none"
    },
    "vehicle_model": {
      "type": "string",
      "enum": [
        "AIR",
        "GRAVITY"
      ],
      "x-privacy": "none"
    },
    "fleet": {
      "type": "string",
      "enum": [
        "consumer",
        "robotaxi"
      ],
      "x-privacy": "none"
    },
    "market": {
      "type": "string",
      "enum": [
        "us-bay-area",
        "us-houston",
        "us-phoenix"
      ],
      "x-privacy": "none"
    },
    "firmware_version": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{1,2}\\.[0-9]{1,2}$",
      "description": "Firmware running when the event was produced, e.g. 2026.10.1.",
      "x-privacy": "none"
    },
    "envelope": {
      "type": "object",
      "description": "Canonical envelope shared by all 4 input topics. Topic schemas repeat these fields explicitly (same names, same $defs) and narrow event_type to a topic-specific enum. tests/test_schemas.py checks they match.",
      "additionalProperties": false,
      "required": [
        "event_id",
        "vin",
        "event_time",
        "event_type",
        "producer_seq",
        "schema_version",
        "vehicle_model",
        "fleet",
        "market",
        "firmware_version"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/event_id",
          "x-privacy": "none"
        },
        "vin": {
          "$ref": "#/$defs/vin",
          "x-privacy": "vehicle-id"
        },
        "event_time": {
          "$ref": "#/$defs/timestamp",
          "x-privacy": "none",
          "description": "When the event happened on the vehicle (true event time)."
        },
        "event_type": {
          "type": "string",
          "x-privacy": "none",
          "description": "Enum defined per topic; always includes heartbeat."
        },
        "producer_seq": {
          "$ref": "#/$defs/producer_seq",
          "x-privacy": "none"
        },
        "schema_version": {
          "$ref": "#/$defs/schema_version",
          "x-privacy": "none"
        },
        "vehicle_model": {
          "$ref": "#/$defs/vehicle_model",
          "x-privacy": "none"
        },
        "fleet": {
          "$ref": "#/$defs/fleet",
          "x-privacy": "none"
        },
        "market": {
          "$ref": "#/$defs/market",
          "x-privacy": "none"
        },
        "firmware_version": {
          "$ref": "#/$defs/firmware_version",
          "x-privacy": "none"
        }
      }
    }
  }
}
