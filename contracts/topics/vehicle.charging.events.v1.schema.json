{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.telemetry.example/topics/vehicle.charging.events.v1.schema.json",
  "title": "Vehicle charging events",
  "description": "Charging telemetry from the vehicle. A session is charge_start, then charge_progress every 1-5 minutes, then charge_stop (about 3% of sessions have no charge_stop). power_kw is capped per charger_type: home 11.5, ac_l2 19.2, dc_fast 400. Every VIN gets exactly one heartbeat on this topic, as its last record, with event_time = that VIN's last non-heartbeat event_time on this topic + 2 hours (or window end + 2 hours if it has none).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "vin",
    "event_time",
    "event_type",
    "producer_seq",
    "schema_version",
    "vehicle_model",
    "fleet",
    "market",
    "firmware_version",
    "connector_type",
    "charger_type",
    "power_kw",
    "energy_added_kwh",
    "soc_pct",
    "charger_lat",
    "charger_lon"
  ],
  "x-topic": "vehicle.charging.events.v1",
  "x-key": "vin",
  "x-partitions": 6,
  "x-cleanup-policy": "delete",
  "x-partitioner": "murmur2",
  "x-producer": "vehicle",
  "x-consumers": [
    "charging-session-builder"
  ],
  "properties": {
    "event_id": {
      "$ref": "../common.schema.json#/$defs/event_id",
      "x-privacy": "none"
    },
    "vin": {
      "$ref": "../common.schema.json#/$defs/vin",
      "x-privacy": "vehicle-id"
    },
    "event_time": {
      "$ref": "../common.schema.json#/$defs/timestamp",
      "x-privacy": "none",
      "description": "When the event happened on the vehicle (true event time)."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "charge_start",
        "charge_progress",
        "charge_stop",
        "heartbeat"
      ],
      "x-privacy": "none",
      "description": "heartbeat carries the envelope only; every domain field is null."
    },
    "producer_seq": {
      "$ref": "../common.schema.json#/$defs/producer_seq",
      "x-privacy": "none"
    },
    "schema_version": {
      "$ref": "../common.schema.json#/$defs/schema_version",
      "x-privacy": "none"
    },
    "vehicle_model": {
      "$ref": "../common.schema.json#/$defs/vehicle_model",
      "x-privacy": "none"
    },
    "fleet": {
      "$ref": "../common.schema.json#/$defs/fleet",
      "x-privacy": "none"
    },
    "market": {
      "$ref": "../common.schema.json#/$defs/market",
      "x-privacy": "none"
    },
    "firmware_version": {
      "$ref": "../common.schema.json#/$defs/firmware_version",
      "x-privacy": "none"
    },
    "connector_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "NACS",
        "CCS1",
        "J1772",
        null
      ],
      "x-privacy": "none"
    },
    "charger_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "home",
        "ac_l2",
        "dc_fast",
        null
      ],
      "x-privacy": "none"
    },
    "power_kw": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 400,
      "x-decimals": 1,
      "description": "Instantaneous charging power. 0.0 on charge_start and charge_stop.",
      "x-privacy": "none"
    },
    "energy_added_kwh": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "x-decimals": 3,
      "description": "Cumulative energy added since this session's charge_start. Never decreases within a session.",
      "x-privacy": "none"
    },
    "soc_pct": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100,
      "x-decimals": 1,
      "description": "Battery state of charge.",
      "x-privacy": "none"
    },
    "charger_lat": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -90,
      "maximum": 90,
      "description": "Charger latitude. For home sessions this is the owner's home.",
      "x-privacy": "precise-location",
      "x-precision": 5
    },
    "charger_lon": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -180,
      "maximum": 180,
      "description": "Charger longitude. For home sessions this is the owner's home.",
      "x-privacy": "precise-location",
      "x-precision": 5
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "heartbeat"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "connector_type": {
            "type": "null"
          },
          "charger_type": {
            "type": "null"
          },
          "power_kw": {
            "type": "null"
          },
          "energy_added_kwh": {
            "type": "null"
          },
          "soc_pct": {
            "type": "null"
          },
          "charger_lat": {
            "type": "null"
          },
          "charger_lon": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "connector_type": {
            "type": "string"
          },
          "charger_type": {
            "type": "string"
          },
          "power_kw": {
            "type": "number"
          },
          "energy_added_kwh": {
            "type": "number"
          },
          "soc_pct": {
            "type": "number"
          },
          "charger_lat": {
            "type": "number"
          },
          "charger_lon": {
            "type": "number"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "charger_type": {
            "const": "home"
          }
        },
        "required": [
          "charger_type"
        ]
      },
      "then": {
        "properties": {
          "power_kw": {
            "maximum": 11.5
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "charger_type": {
            "const": "ac_l2"
          }
        },
        "required": [
          "charger_type"
        ]
      },
      "then": {
        "properties": {
          "power_kw": {
            "maximum": 19.2
          }
        }
      }
    }
  ]
}
