{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.telemetry.example/topics/vehicle.diagnostics.dtc.v1.schema.json",
  "title": "Vehicle diagnostic trouble codes",
  "description": "Diagnostic trouble codes raised (status active) and later cleared (status cleared) by an ECU. Every VIN gets exactly one heartbeat on this topic, as its last record, with event_time = that VIN's last non-heartbeat event_time on this topic + 2 hours (or window end + 2 hours if it has none).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "vin",
    "event_time",
    "event_type",
    "producer_seq",
    "schema_version",
    "vehicle_model",
    "fleet",
    "market",
    "firmware_version",
    "dtc_code",
    "severity",
    "ecu",
    "status",
    "lat",
    "lon",
    "odometer_km"
  ],
  "x-topic": "vehicle.diagnostics.dtc.v1",
  "x-key": "vin",
  "x-partitions": 6,
  "x-cleanup-policy": "delete",
  "x-partitioner": "murmur2",
  "x-producer": "vehicle",
  "x-consumers": [
    "diagnostics-dtc-router"
  ],
  "properties": {
    "event_id": {
      "$ref": "../common.schema.json#/$defs/event_id",
      "x-privacy": "none"
    },
    "vin": {
      "$ref": "../common.schema.json#/$defs/vin",
      "x-privacy": "vehicle-id"
    },
    "event_time": {
      "$ref": "../common.schema.json#/$defs/timestamp",
      "x-privacy": "none",
      "description": "When the event happened on the vehicle (true event time)."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "dtc",
        "heartbeat"
      ],
      "x-privacy": "none",
      "description": "heartbeat carries the envelope only; every domain field is null."
    },
    "producer_seq": {
      "$ref": "../common.schema.json#/$defs/producer_seq",
      "x-privacy": "none"
    },
    "schema_version": {
      "$ref": "../common.schema.json#/$defs/schema_version",
      "x-privacy": "none"
    },
    "vehicle_model": {
      "$ref": "../common.schema.json#/$defs/vehicle_model",
      "x-privacy": "none"
    },
    "fleet": {
      "$ref": "../common.schema.json#/$defs/fleet",
      "x-privacy": "none"
    },
    "market": {
      "$ref": "../common.schema.json#/$defs/market",
      "x-privacy": "none"
    },
    "firmware_version": {
      "$ref": "../common.schema.json#/$defs/firmware_version",
      "x-privacy": "none"
    },
    "dtc_code": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[PBCU][0-9A-F]{4}$",
      "x-privacy": "none"
    },
    "severity": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 5,
      "description": "1 (informational) to 5 (critical).",
      "x-privacy": "none"
    },
    "ecu": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "central_compute",
        "zone_left",
        "zone_right",
        "bms",
        "inverter_front",
        "inverter_rear",
        null
      ],
      "x-privacy": "none"
    },
    "status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "active",
        "cleared",
        null
      ],
      "x-privacy": "none"
    },
    "lat": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -90,
      "maximum": 90,
      "x-privacy": "precise-location",
      "x-precision": 5
    },
    "lon": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -180,
      "maximum": 180,
      "x-privacy": "precise-location",
      "x-precision": 5
    },
    "odometer_km": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "x-privacy": "none"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "heartbeat"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "dtc_code": {
            "type": "null"
          },
          "severity": {
            "type": "null"
          },
          "ecu": {
            "type": "null"
          },
          "status": {
            "type": "null"
          },
          "lat": {
            "type": "null"
          },
          "lon": {
            "type": "null"
          },
          "odometer_km": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "dtc_code": {
            "type": "string"
          },
          "severity": {
            "type": "integer"
          },
          "ecu": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          },
          "odometer_km": {
            "type": "integer"
          }
        }
      }
    }
  ]
}
